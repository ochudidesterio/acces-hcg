{
  "permissions": {
    "allow": [
      "Bash(node -e ' *)",
      "Bash(npx tsc *)",
      "Bash(npx next *)",
      "Bash(pkill -f \"next dev\")",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3030)",
      "Bash('#team')",
      "Bash('#clients')",
      "Bash(node node_modules/.bin/playwright --version)",
      "Bash(npx next dev --port 3030 &> /tmp/next-dev.log & *)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  }
}
